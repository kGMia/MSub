    "editor.split.choose" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the text positions. Both resulting cues must contain visible text. Position 0 keeps all text in the second cue; the end keeps it all in the first."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字位置を指定してください。両方の字幕に文字が必要です。0 はすべて後半、末尾はすべて前半に残します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请选择文字位置，两个结果均需包含可见文字。0 表示全部留在后段，末尾表示全部留在前段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請選擇文字位置，兩個結果均需包含可見文字。0 表示全部留在後段，末尾表示全部留在前段。"
          }
        }
      }
    },
