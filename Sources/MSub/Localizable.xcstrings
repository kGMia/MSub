    "timing.calibration.first" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First point"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前の点"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前点"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前點"
          }
        }
      }
    },
    "timing.calibration.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose two speech boundaries far apart. Enter each original subtitle time and its matching media time in seconds. The same offset and time scaling apply across the affected cues."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離れた2つの発話境界を選び、元の字幕時刻と対応するメディア時刻を秒で入力します。対象字幕に同じオフセットと時間倍率を適用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择相隔较远的两个语音边界，填写它们原来的字幕时间及对应的实际语音时间（秒）。系统会据此统一调整偏移和时间比例。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇相隔較遠的兩個語音邊界，填寫它們原來的字幕時間及對應的實際語音時間（秒）。系統會據此統一調整偏移和時間比例。"
          }
        }
      }
    },
    "timing.calibration.invalidAnchors" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Both pairs must contain finite, nonnegative times, with the second point at least 0.001 s after the first."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両組に有効な非負の時刻を指定し、後の点を前の点より0.001秒以上後にしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两组时间须为有效非负数，后点至少比前点晚 0.001 秒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩組時間須為有效非負數，後點至少比前點晚 0.001 秒。"
          }
        }
      }
    },
    "timing.calibration.invalidCue" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cue or word has invalid timing. Correct it before calibration."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕または単語の時刻が無効です。先に修正してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存在无效的字幕或词级时间，请先修正再校准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存在無效的字幕或詞級時間，請先修正再校準。"
          }
        }
      }
    },
    "timing.calibration.invalidResult" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These points produce negative or out-of-range times, or cues shorter than 0.05 s. Adjust the points before applying."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定した点では負の時刻、範囲外、または0.05秒未満の字幕になります。点を調整してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前对齐点会产生负时间、超出范围或短于 0.05 秒的字幕，请调整后再应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前對齊點會產生負時間、超出範圍或短於 0.05 秒的字幕，請調整後再套用。"
          }
        }
      }
    },
    "timing.calibration.last" : {
