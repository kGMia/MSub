    "nativeFireRedVAD.requirements" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using backend segmentation: requires local FireRedVAD, VAD mode, supported backend or native Qwen, and denoising/speaker labeling/event filtering off. Maximum segment must be 0.1–30 s; custom backend overrides are unsupported."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックエンドで分割します。ローカル FireRedVAD、VAD モード、対応バックエンドまたはネイティブ Qwen が必要です。ノイズ除去・話者識別・イベントフィルターを無効にしてください。最大区間は 0.1～30 秒で、バックエンド設定の上書きは未対応です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前使用后端分段：需本地 FireRedVAD、VAD 模式、支持此功能的后端或原生 Qwen，并关闭降噪、说话人识别和事件过滤。最长分段须为 0.1–30 秒，不支持后端自定义覆盖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前使用後端分段：需本地 FireRedVAD、VAD 模式、支援此功能的後端或原生 Qwen，並關閉降噪、說話人辨識和事件過濾。最長分段須為 0.1–30 秒，不支援後端自訂覆寫。"
          }
        }
      }
    },
    "nativeQwen.ready" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recognition uses Swift MLX; segmentation follows the VAD settings and reuses existing previews."
          }
        },
