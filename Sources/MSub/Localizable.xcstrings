    "help.audioEventFilter" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Marks likely repeated non-lexical sounds during segment preview with PANNs MLX when available. Without a local model it falls back to lightweight repetition detection."
          }
        }
      }
    },
    "help.audioEventFilterType" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose which candidates are marked automatically, then delete marked segments from the segment list."
          }
        }
      }
    },
    "help.audioEventPreset" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Strict reduces false marks; Broad keeps more suspicious candidates for manual review."
          }
        }
      }
    },
    "help.audioEventThreshold" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Marking threshold. Higher reduces false marks, lower keeps more candidates; 0.45 is a reasonable starting point."
          }
        }
      }
    },
    "help.beam" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model decoding beam width. Larger can be steadier but slower; 3 or 4 is usually enough locally."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型解码搜索宽度。更大可能略稳但更慢；本地实时调试通常 3 或 4 足够。"
          }
        }
      }
    },
    "help.confidence" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drops recognized pieces below this confidence. No effect if the model does not return confidence; raise slightly for noisy audio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "丢弃低于此置信度的识别片段。模型不返回置信度时不会生效；嘈杂素材可略微调高。"
          }
        }
      }
    },
    "help.fixedChunk" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chunk length used by fixed mode. It mostly does not affect VAD mode."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定切片模式下每段时长。VAD 模式下基本不影响结果。"
          }
        }
      }
    },
    "help.format" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SRT/VTT are subtitle formats, TXT is a plain transcript, JSON is best for downstream tooling."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SRT/VTT 用于字幕软件，TXT 用于纯文本稿，JSON 用于后续程序处理。"
          }
        }
      }
    },
    "help.funasr" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fun-ASR Nano can use the context field as a hotword list and supports text normalization."
          }
        }
      }
    },
    "help.lineChars" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subtitle line wrapping width. 14-20 works well for Chinese; set 0 to disable wrapping."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "字幕换行宽度。中文通常 14-20 较舒服，设为 0 可关闭自动换行。"
          }
        }
      }
    },
    "help.maxSegment" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximum duration for one recognition segment. Shorter gives tighter subtitles; too short can lose context."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单个识别分段允许的最长时间。越短字幕越碎、越贴近语音；过短可能损失上下文。"
          }
        }
      }
    },
    "help.mega" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mega-ASR routes each utterance internally. Auto language usually works, and known media languages can be set manually. It uses greedy decoding and a dynamic token limit."
          }
        }
      }
    },
    "help.minSegment" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiny split remainders below this are merged. Lower it to keep more short subtitles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切分后过短的小段会被合并。降低它会保留更多短字幕。"
          }
        }
      }
    },
    "help.minSpeech" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detected speech shorter than this is treated as noise. Raise for noisy audio; lower for quiet speech."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短于此值的语音活动会被视为噪声。嘈杂素材可调高，低音量语音可调低。"
          }
        }
      }
    },
    "help.mode" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VAD segments by detected speech activity and is usually better for subtitle sync; fixed chunks are a fallback."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VAD 会按实际语音活动分段，通常更适合字幕同步；固定切片只作为回退方案。"
          }
        }
      }
    },
    "help.model" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a Hugging Face model id or a local model folder."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可填写 Hugging Face 模型 ID 或本地模型目录。"
          }
        }
      }
    },
    "help.model.funasr" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fun-ASR Nano 2512 MLX suits Chinese, English, Japanese, and Chinese dialect media. It supports language hints, hotword context, text normalization, and generation controls."
          }
        }
      }
    },
    "help.model.mega" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mega-ASR BF16 supports recognition in 30 languages and internal utterance routing. Language hints, max tokens, temperature, top-p, and top-k apply; FireRed AED controls do not."
          }
        }
      }
    },
    "help.model.qwen3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Qwen3-ASR MLX supports 30 language hints, context prompts, and streaming progress. FireRed AED controls do not apply."
          }
        }
      }
    },
    "help.nativeFireRedVAD" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Accelerate and Core ML for FireRedVAD preview and segmentation before Swift or Python recognition. Requires a local FireRedVAD model and VAD mode; turn off denoising, speaker labeling and audio-event filtering. Matching edited segments are reused. Unsupported settings or native failures use the backend."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accelerate と Core ML で音声区間を検出し、Swift または Python の認識エンジンに渡します。ローカル FireRedVAD モデルと VAD モードが必要です。ノイズ除去、話者識別、音声イベントフィルターは無効にしてください。設定が同じなら編集済み区間を再利用します。未対応の設定や検出失敗時はバックエンドを使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Accelerate 和 Core ML 预览及检测语音，供 Swift 或 Python 识别引擎使用。需安装 FireRedVAD 模型，使用 VAD 分段，并关闭降噪、说话人识别和音频事件过滤。参数一致时复用编辑后的分段；不支持的设置或原生检测失败时使用后端。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Accelerate 和 Core ML 預覽及偵測語音，供 Swift 或 Python 辨識引擎使用。需安裝 FireRedVAD 模型，使用 VAD 分段，並關閉降噪、說話人辨識和音訊事件過濾。參數一致時重用編輯後的分段；不支援的設定或原生偵測失敗時使用後端。"
          }
        }
      }
    },
    "help.nativeQwen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recognize with Swift MLX using an installed local model and greedy decoding. Segmentation follows the VAD settings. Unsupported analysis options or native failures use Python."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済みローカルモデルと貪欲デコードで Swift MLX 認識を実行します。分割は VAD 設定に従います。未対応の分析機能や失敗時は Python を使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用已安装的本地模型和贪心解码进行 Swift MLX 识别，分段遵循 VAD 设置。不支持的附加分析功能或原生失败时使用 Python 引擎。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用已安裝的本地模型和貪心解碼進行 Swift MLX 辨識，分段遵循 VAD 設定。不支援的附加分析功能或原生失敗時使用 Python 引擎。"
          }
        }
      }
    },
    "help.noNativeSpeakerLabels" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For speaker labels, use pyannote diarization or ERes2NetV2 embedding clustering."
          }
        }
      }
    },
    "help.padding" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extra time before and after each segment. More avoids clipped words; less makes subtitles tighter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给每段开头和结尾额外保留的时间。增加可避免吞字，减少可让字幕出现/消失更贴合语音。"
          }
        }
      }
    },
    "help.preset" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies a starting point for segmentation and recognition settings. You can still fine-tune manually."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一键调整下方分段和识别参数。预设只是起点，仍可继续手动微调。"
          }
        }
      }
    },
    "help.qwen3" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Qwen3-ASR uses its own engine entry, streaming progress, and a token limit capped by segment duration."
          }
        }
      }
    },
    "help.search" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search window around a long-segment cut point for the quietest frame. Larger can find more natural cuts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长分段切开时，在目标切点附近搜索最安静位置的范围。增大可找到更自然切点。"
          }
        }
      }
    },
    "help.silence" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silences shorter than this are bridged. Lower values split more; higher values merge more."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短于此值的静音会被合并到同一段。调小会切得更碎，调大会减少碎片。"
          }
        }
      }
    },
    "help.threshold" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech energy threshold. Higher is stricter and reduces noise; lower catches quieter speech."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音能量阈值。数值越高越严格，噪声更少但可能漏掉轻声；数值越低越灵敏。"
          }
        }
      }
    },
    "help.vadEngine.pyannote_mlx" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
