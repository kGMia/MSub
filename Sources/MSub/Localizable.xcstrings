        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空欄で話者を解除します。登録済みの話者色は原文と訳文に適用します。色がない場合は現在の書式を保持します。"
          }
        },
        "zh-Hans" : {
