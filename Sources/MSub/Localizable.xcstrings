    "editor.split.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose each text boundary independently; the vertical bar marks the split. Each cue must last at least 0.05 seconds. Word timings are kept only when they match the source boundary. Choose the translation boundary separately."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原文と訳文の文字境界を個別に指定します。縦線が分割位置です。各区間は最低 0.05 秒。単語の時刻は原文の境界と一致する場合のみ保持します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分别选择文字边界，竖线表示拆分位置。每段至少保留 0.05 秒。字词时间仅在与原文边界吻合时保留；译文需单独选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分別選擇文字邊界，直線表示拆分位置。每段至少保留 0.05 秒。字詞時間僅在與原文邊界吻合時保留；譯文需單獨選擇。"
          }
        }
      }
    },
    "editor.split.markup" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The text contains unsupported or unclosed formatting tags. Correct the tags or clear formatting before splitting. The cue has not been changed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未対応または閉じられていない書式タグがあります。タグを修正するか書式を解除してから分割してください。字幕は変更されていません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字含不支持或未闭合的样式标签。请先修正标签或清除样式，再拆分；当前字幕未被修改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
