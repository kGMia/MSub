      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merge with Next Cue"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の字幕と結合"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与下一条合并"
          }
        },
        "zh-Hant" : {
