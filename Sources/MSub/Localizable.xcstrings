    "editor.batch.styleHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existing styles are not toggled off. The language scope applies to each cue; translation-only skips plain subtitles and empty fields remain empty."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存の書式は反転しません。言語範囲は各字幕に適用します。訳文のみの場合、通常の字幕は対象外です。空の言語は空のままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有样式不会反转。语言范围作用于每条字幕；仅译文会跳过普通字幕，空语言保持为空。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現有樣式不會反轉。語言範圍作用於每條字幕；僅譯文會略過一般字幕，空語言保持空白。"
          }
        }
      }
    },
    "editor.batch.time" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timing"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時刻"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
