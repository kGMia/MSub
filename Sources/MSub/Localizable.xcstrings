    "editor.mergeNext.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merge adjacent cues with the same speaker and text type (both plain or both bilingual). The time span includes any gap; bilingual fields are joined separately using the first cue’s display order. Undo restores both cues."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話者と言語形式（単言語同士、または二言語同士）が同じ隣接字幕を結合します。時間範囲には間の空白も含みます。原文と訳文は別々に結合し、最初の字幕の表示順を保持します。取り消しで両方を復元できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合并同一说话人、同为单语或双语的相邻字幕。时间范围包含中间空隙；双语分别合并原文和译文，沿用当前字幕的显示顺序。可撤销恢复两条字幕。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合併同一說話人、同為單語或雙語的相鄰字幕。時間範圍包含中間空隙；雙語分別合併原文和譯文，沿用目前字幕的顯示順序。可復原恢復兩條字幕。"
          }
        }
      }
    },
    "editor.split.apply" : {
