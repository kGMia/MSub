    "bilingual.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit each language separately. Normal save exports both; drafts and JSON keep the separate fields. Choose a language scope in Subtitle Style to format either language."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各言語を別々に編集できます。通常の保存は両言語を出力し、下書きとJSONは個別の項目を保持します。字幕スタイルで書式を設定する言語を選べます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在两个框中分别编辑。普通保存导出双语，草稿和 JSON 保留分开的原文/译文。可在字幕样式中选择要设置格式的语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在兩個框中分別編輯。一般儲存匯出雙語，草稿和 JSON 保留分開的原文／譯文。可在字幕樣式中選擇要設定格式的語言。"
          }
        }
      }
    },
