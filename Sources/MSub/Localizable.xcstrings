        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間"
          }
        }
      }
    },
    "editor.batch.timeHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positive delays, negative advances. Durations are preserved and word timings move with the cues. Any negative resulting time blocks the entire batch. Overlaps with other cues are not automatically removed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正数で遅らせ、負数で早めます。長さを保ち単語の時刻も移動します。負の時刻が生じる場合は全体に適用しません。他の字幕との重なりは自動修正しません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正数延后，负数提前；保持时长并同步移动字词时间。若任一条变为负时间，整批不应用。不会自动消除与其他字幕的重叠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正數延後，負數提前；保持時長並同步移動字詞時間。若任一條變為負時間，整批不套用。不會自動消除與其他字幕的重疊。"
          }
        }
      }
    },
